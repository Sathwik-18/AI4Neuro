# AI4NEURO frontend environment.
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase browser/client auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Legacy/compat frontend variable used by older components.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# App URL used in generated invitation/login emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase key for Next.js admin API routes.
# Prefer Supabase sb_secret_... key. Do not prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local email settings for admin-created user invitation emails.
# Leave empty if teammates do not need email sending locally.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
