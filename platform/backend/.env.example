# Unified Neuro Platform - backend environment.
# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# ---- Application ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Firebase (shared project with ManasMitra) ----
# FIREBASE_PROJECT_ID switches the backend onto Firebase. The credentials file
# is a service-account key (Firebase console -> Project settings -> Service
# accounts); never commit it. The bucket defaults to
# "<project>.firebasestorage.app".
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# ---- Supabase (LEGACY) ----
# Only used while FIREBASE_PROJECT_ID is empty, so an existing local setup
# keeps working during the migration. Removed at cut-over.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Storage buckets ----
RAW_FILES_BUCKET=raw-files
REPORT_ASSETS_BUCKET=report-assets
REPORTS_BUCKET=reports
VIEWER_SLICES_BUCKET=viewer-slices

# ---- Background jobs ----
JOB_BACKEND=local
LOCAL_JOB_MAX_WORKERS=2

# ---- Uploads ----
LOCAL_TMP_DIR=/tmp/neuro-platform
MAX_UPLOAD_MB=512
# Must comfortably cover how long a large raw scan takes to actually finish
# uploading to Supabase Storage on a slow connection, not just a REST query.
# SUPABASE_HTTP_TIMEOUT_SECONDS=600

# ---- Auth ----
# Keep true for local dev before full auth is wired; MUST be false in production.
AUTH_DEV_BYPASS=true

# ---- EEG pipeline ----
# Defaults point at platform/backend/models/eeg/checkpoints and
# platform/backend/representative, so these are only needed if you move the models.
# EEG_SIDDHI_DIR=
# EEG_CHECKPOINT_ROOT=
# EEG_REFERENCE_DIR=
# EEG_USE_GPU=false

# ---- MRI pipeline ----
# Defaults to platform/backend/models/mri/ConVit_checkpoint.pth. Without a
# checkpoint, MRI analysis jobs fail explicitly instead of returning mock predictions.
# CONVIT_CHECKPOINT_PATH=
#
# Optional dedicated CN-vs-AD model. When empty, binary requests use the
# multiclass checkpoint with CN vs AD renormalised (reported as derived).
# MRI_BINARY_CHECKPOINT_PATH=
#
# Swapping in a new model: save a .pth dict with `model_state_dict`, plus
# `arch` (a timm model name) and `class_names` (output order, e.g.
# ["CN","MCI","AD"] or ["CN","AD"]), then point the path above at it and
# set MRI_MODEL_VERSION. No code changes needed for timm 2D-slice models.
# MRI_MODEL_VERSION=ConViT-v1.0
#
# When USE_CAT12_PREPROCESSING=true, the uploaded raw T1 NIfTI is run through
# CAT12 segmentation first (mwp1/mwp2/p0 + real volumetrics) before ConViT
# inference. Requires a standalone CAT12 + MATLAB Runtime install (see
# platform/backend/models/README.md and app/pipelines/mri/cat12_manager.py).
# When false (default), the uploaded scan is treated as already preprocessed.
# Works on both Windows and Mac/Linux - only CAT12_EXE's filename differs
# (cat12_standalone.bat vs run_spm25.sh); see models/README.md for exact
# per-OS paths.
# USE_CAT12_PREPROCESSING=false
# CAT12_ROOT=
# CAT12_EXE=
# MCR_ROOT=
# CAT12_OUTPUT_DIR=
# A clean CAT12 run takes ~15-20 min; this needs real margin on top for CPU
# contention with everything else running on a dev machine.
# CAT12_TIMEOUT_SECONDS=3600
# MRI_USE_GPU=false
