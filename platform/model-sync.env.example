# AI4NEURO model artifact sync settings.
# Copy values into your shell, CI secret store, or Oracle VM secret file.
# Never commit real access keys.

# Cloudflare R2 / S3-compatible credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Current shared model artifact store.
MODEL_BUCKET=ai4neuro-models
MODEL_PREFIX=ai4neuro
MODEL_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# Local destination for downloaded model files.
# Local teammate default is auto-detected as:
# platform/backend/models
# Leave MODEL_DIR unset locally unless you intentionally want a custom path.

# Oracle VM recommended value:
# MODEL_DIR=/opt/ai4neuro/models
